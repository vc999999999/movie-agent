# LLM Configuration (OpenAI, DeepSeek, Qwen, Ollama, etc.)
OPENAI_API_KEY=sk-your-openai-or-deepseek-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
LLM_MOCK_MODE=false

# Optional online rendering only; portable ZIP export needs no ComfyUI connection.
# ComfyUI Configuration
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
COMFYUI_MOCK_MODE=false
COMFYUI_VRAM_GB=24

# Agent Limits
MAX_QUESTION_ROUNDS=3
MAX_QUESTIONS_PER_ROUND=3

# Cloud generation backend (ModelScope API-Inference)
# render_backend: "comfyui" (default) or "modelscope" — use "modelscope" on GPU-less hosts
RENDER_BACKEND=comfyui
MODELSCOPE_API_KEY=ms-your-modelscope-token
# LLM via ModelScope API-Inference (streaming supported)
# OPENAI_BASE_URL=https://api-inference.modelscope.cn/v1
# OPENAI_MODEL=Qwen/Qwen3.5-397B-A17B
